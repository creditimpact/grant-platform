{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Structured OCR Output",
  "type": "object",
  "required": ["pages", "text", "engine", "engine_version", "character_count"],
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "lines", "page_text"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "page_text": {"type": "string"},
          "raw_text": {"type": "string"},
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line_index", "text"],
              "properties": {
                "line_index": {"type": "integer", "minimum": 0},
                "text": {"type": "string"},
                "bbox": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 4,
                  "maxItems": 4
                },
                "font_size": {"type": "number"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "text": {"type": "string"},
    "engine": {"type": "string"},
    "engine_version": {"type": "string"},
    "character_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
